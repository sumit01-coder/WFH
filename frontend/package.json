{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:build": "vite build && copy electron\\preload.cjs dist-electron\\preload.cjs && copy electron\\monitor.cjs dist-electron\\monitor.cjs && electron-builder",
    "electron:publish": "vite build && copy electron\\preload.cjs dist-electron\\preload.cjs && copy electron\\monitor.cjs dist-electron\\monitor.cjs && electron-builder --publish always"
  },
  "build": {
    "appId": "com.workflowpro.app",
    "productName": "WorkFlow Pro",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sumit01-coder",
        "repo": "WFH",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.20.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "screenshot-desktop": "^1.15.6",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2"
  }
}
